<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Itch.io Butler Utility</AssemblyName>
    <RootNamespace>ItchioButlerUtility</RootNamespace>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Local-build fallback only. Releases are versioned from the git tag:
         the release workflow passes -p:Version=<tag>. -->
    <Version>1.1.1</Version>
    <!-- Keeps the win-x64 graph in project.assets.json for every restore, so a
         RID-specific publish still works right after a plain build. Without it,
         publishing after a Debug build fails with NETSDK1047. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="butler.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exact versions, not 11.3.*: a release build must not change because a patch
       was published. Bump these deliberately (Dependabot opens the PRs). -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.19" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.19" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.19" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.19" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.19" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
